  </row>
  <row>
    <panel>
      <chart>
        <title>Cate Trends Group 1</title>
        <search>
          <query>
              index="cashflow-1.1"
              | where Cycle &gt;= strftime(now() - 3600 * 24 * (365 + 31), "%y%m")
              | lookup Constant-Categories.csv Category OUTPUT Spending as spending
              | where spending = "TRUE"
              | eval adjustedAmount = -Amount
              | stats sum(adjustedAmount) as SubTotal by Cycle, Category
              | eventstats median(SubTotal) as cat_median by Category
              | sort 0 -cat_median, Category, Cycle
              | streamstats dc(Category) as cat_num
              | eval group = ceil(cat_num / 5)
              | where group = 1
              | fields - cat_median, cat_num, group
              | xyseries Cycle Category SubTotal
              | sort Cycle
          </query>
          <earliest>0</earliest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.axisTitleY.visibility">collapsed</option>
        <option name="charting.axisY.maximumNumber">5000</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">zero</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.stackMode">default</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.legend.placement">bottom</option>
        <drilldown>
          <set token="cycle">$click.value$</set>
          <set token="category">$click.name2$</set>
