  <row>
    <panel>
      <table>
        <title>Average Spending per Cycle by Category in the last 13 cycles</title>
        <search>
          <query>
              index="cashflow-1.1"
              | where Cycle &gt;= strftime(now() - 3600 * 24 * (365 + 31), "%y%m")
              | lookup Constant-Categories.csv Category OUTPUT Spending as spending
              | where spending = "TRUE"
              | eval adjustedAmount = -Amount
              | eventstats dc(Cycle) as n_cycles
              | stats sum(adjustedAmount) as Total dc(Cycle) as Cycles max(n_cycles) as n_cycles by Category
              | append [| inputlookup Constant-Categories.csv | where Spending = "TRUE" | fields Category]
              | eventstats max(n_cycles) as n_cycles
              | stats sum(Total) as Total max(Cycles) as Cycles max(n_cycles) as n_cycles by Category
              | fillnull value=0 Total Cycles
              | eval "Avg per Cycle" = round(Total / n_cycles, 2), "13-Cycle Total" = round(Total, 2)
              | rename Cycles as "Cycles with Spending"
              | sort 0 - "Avg per Cycle"
              | table Category, "Avg per Cycle", "13-Cycle Total", "Cycles with Spending"
              | addcoltotals labelfield=Category label="TOTAL" "Avg per Cycle" "13-Cycle Total"
          </query>
          <earliest>0</earliest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">100</option>
        <option name="drilldown">row</option>
        <drilldown>
