<dashboard theme="dark">
  <init>
    <eval token="cycle">strftime(now() - 3600 * 24 * 30, "%y%m")</eval>
    <set token="category">ALL</set>
  </init>
  <label>Spending</label>
  <row>
    <panel>
      <chart>
        <title>Flex Spending by Cycle in the last 13 cycles</title>
        <search>
          <query>index="cashflow-1.1"
                  | where Cycle &gt;= strftime(now() - 3600 * 24 * (365 + 31), "%y%m")
                  | lookup Constant-Categories.csv Category OUTPUT Spending as spending, FlexSpending as flex
                  | where spending="TRUE"
                  | where flex = "TRUE"
                  | eval adjustedAmount = -Amount
                  | chart sum(adjustedAmount) as SubTotal by Cycle
                  | sort Cycle
                  | eventstats median(SubTotal) as Median</query>
          <earliest>0</earliest>
          <sampleRatio>1</sampleRatio>
        </search>
        <!--<search ref="Spending by Cycle by Flex in the last 13 cycles"></search>-->
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.axisY.maximumNumber">10000</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.axisY2.enabled">0</option>
        <option name="charting.chart">area</option>
        <option name="charting.chart.nullValueMode">gaps</option>
        <option name="charting.chart.overlayFields">Median</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.stackMode">default</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.layout.splitSeries">0</option>
        <option name="charting.legend.labelStyle.overflowMode">ellipsisEnd</option>
        <option name="charting.legend.mode">standard</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0xffff00]</option>
        <drilldown>
          <set token="cycle">$click.value$</set>
          <set token="category">ALL</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Non-Flex Spending by Cycle in the last 13 cycles</title>
        <search>
          <query>
            index="cashflow-1.1"
              | where Cycle &gt;= strftime(now() - 3600 * 24 * (365 + 31), "%y%m")
              | lookup Constant-Categories.csv Category OUTPUT Spending as spending, FlexSpending as flex
              | where spending="TRUE"
              | where NOT flex = "TRUE"
              | eval adjustedAmount = -Amount
              | chart sum(adjustedAmount) as SubTotal by Cycle
              | sort Cycle
          </query>
          <earliest>0</earliest>
          <sampleRatio>1</sampleRatio>
        </search>
        <!--<search ref="Spending by Cycle by Flex in the last 13 cycles"></search>-->
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.axisY.maximumNumber">50000</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.axisY2.abbreviation">none</option>
        <option name="charting.axisY2.enabled">0</option>
        <option name="charting.chart">area</option>
        <option name="charting.chart.overlayFields">stdev,stdev_6m</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.chart.stackMode">default</option>
        <option name="charting.drilldown">all</option>
        <option name="charting.layout.splitSeries">0</option>
        <option name="charting.legend.labelStyle.overflowMode">ellipsisEnd</option>
        <option name="charting.legend.mode">standard</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0xaaaaaa]</option>
        <drilldown>
          <set token="cycle">$click.value$</set>
          <set token="category">ALL</set>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
